# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
AIRFLOW_UID=50000
# สมัครฟรีที่ https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_api_key_here
# ฐานข้อมูลปลายทาง (PostgreSQL ที่ dashboard อ่าน)
FOOTBALL_DB_USER=football
FOOTBALL_DB_PASSWORD=change_me
FOOTBALL_DB_NAME=football
# บัญชีเข้า Airflow UI
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change_me
